# Minimal configuration for Bun + WhatsApp Pairing Code
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
AUTH_GLOBAL_TOKEN=replace-with-a-long-random-token
AUTH_STATE_BACKEND=file
DASHBOARD_ENABLED=false
SESSION_ID=whatsapp-main
PHONE_NUMBER=9665XXXXXXXX

# WhatsApp YouTube downloader. Replace the example with the sender's
# international number (digits only). For self-chat, use the paired number.
YOUTUBE_WA_ENABLED=true
YOUTUBE_WA_ALLOWED_SENDERS=15551234567
YOUTUBE_WA_MAX_SIZE_MB=100
YOUTUBE_WA_MAX_DURATION_SECONDS=1800
