# ===================================
# Server Configuration
# ===================================
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# ===================================
# Authentication
# ===================================
# Simple auth mode: single global token
# Leave empty to disable simple auth (use Redis API keys instead)
# Supported token headers for API requests:
# - Authorization: Bearer <token>
# - x-api-key: <token>
# - x-access-token: <token>
# - token: <token>
AUTH_GLOBAL_TOKEN=
# Brute-force protection for the dashboard login (per account and per IP).
AUTH_MAX_FAILURES=10
AUTH_FAILURE_WINDOW_MS=900000
AUTH_LOCK_MS=900000
# REST API limits and send guards.
RATE_LIMIT_API_KEY=60
SEND_TIMEOUT_MS=30000
MAX_CONCURRENT_SENDS=5

# ===================================
# Redis Configuration (Optional)
# ===================================
# Set to true to enable Redis for auth state, API keys, and broadcast queue
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Which store keeps WhatsApp auth state: auto | file | redis
# - auto  : prefer Redis when reachable, but fall back to files when Redis is
#           empty and sessions exist on disk (so logins are never "lost")
# - file  : sessions/ directory, ignores Redis
# - redis : Redis only; startup fails if Redis is unreachable
# The first successful start records the backend in data/auth-state-backend.json
# and later starts stick to it, so a Redis outage cannot move the store.
# Switching an existing installation requires BOTH a different
# AUTH_STATE_BACKEND and this one-shot confirmation. Sessions are not migrated
# and the old store is kept untouched; re-link by QR on the new store.
# AUTH_STATE_SWITCH_CONFIRM=true
AUTH_STATE_BACKEND=auto
# Content-Security-Policy mode. false = enforce (default, recommended).
# true = Report-Only: violations do NOT block resources, but browsers STILL
# print them to the console; they are also posted to /dashboard/csp-report.
# It does not silence the console — filter CSP messages in DevTools instead.
CSP_REPORT_ONLY=false
# CDNs (jsdelivr, unpkg, cdnjs, Google Fonts) are allowed by default. Set false
# for a same-origin-only policy. Add extra origins per directive as needed.
CSP_CDN=true
# Swagger UI assets: cdn (default, version-pinned + SRI) or local (offline)
DOCS_ASSETS=cdn
# CSP_EXTRA_SCRIPT_SRC=https://example.com
# CSP_EXTRA_STYLE_SRC=
# CSP_EXTRA_FONT_SRC=
# CSP_EXTRA_IMG_SRC=
# CSP_EXTRA_CONNECT_SRC=

# ===================================
# Baileys Configuration
# ===================================
BAILEYS_LOG_LEVEL=warn
# Use 'default' to auto-fetch latest version
BAILEYS_CLIENT_VERSION=default
# Maximum retry attempts to reconnect (-1 for infinite)
MAX_RETRIES=5
# Delay in ms between reconnection attempts
RECONNECT_INTERVAL=5000
# Maximum concurrent WhatsApp sessions
MAX_SESSIONS=50
# Messages kept per chat in memory/snapshot (AI history has its own limit).
MAX_MESSAGES_PER_CHAT=50
# Per-role session quota for non-admin dashboard users (0 = unlimited).
# Admin accounts are never limited.
MAX_SESSIONS_PER_USER=3
MAX_SESSIONS_PER_MANAGER=5

# ===================================
# Message Filtering
# ===================================
IGNORE_GROUP_MESSAGES=false
IGNORE_STATUS_MESSAGES=true
IGNORE_BROADCAST_MESSAGES=true
IGNORE_NEWSLETTER_MESSAGES=true
IGNORE_BOT_MESSAGES=true
IGNORE_META_AI_MESSAGES=true

# ===================================
# Auto Reply Configuration
# ===================================
AUTO_REPLY_ENABLED=true
# Always wrap values in double quotes ("text").
# Line Breaks: Use \n for new lines.
# Escaping with backslash: \" for double quotes.
AUTO_REPLY_MESSAGE="Hello, we're currently away.\nWe'll reply to your message soon."
# always, time_range, on_webhook_fail
AUTO_REPLY_TYPE=on_webhook_fail
# Role inside the responder chain (AI -> static -> webhook events):
#   both     = primary when AI is off/out of window + fallback when AI fails
#   primary  = answers whenever enabled; AI runs only when static is off
#   fallback = answers only when the AI fails (credit, API error, guard)
AUTO_REPLY_ROLE=both
AUTO_REPLY_TIME_START=18:00
AUTO_REPLY_TIME_END=08:00

# ===================================
# Webhook Configuration
# ===================================
# Global default webhook URL (can be overridden per session)
# Outbound webhook authentication fallback order:
#   per-session webhook secret -> AUTH_GLOBAL_TOKEN (only when fallback is enabled)
WEBHOOK_URL=
# Allow AUTH_GLOBAL_TOKEN as fallback webhook secret when session secret is empty.
# Default behavior in code:
# - development: true
# - production : false
# Set explicitly to avoid ambiguity.
# WARNING: enabling this in production may expose AUTH_GLOBAL_TOKEN to third-party webhook receivers.
WEBHOOK_ALLOW_GLOBAL_TOKEN_FALLBACK=true
# Comma-separated list of allowed events, or 'ALL'
# Available: MESSAGES_UPSERT, MESSAGES_UPDATE, MESSAGES_DELETE, MESSAGES_REACTION,
#            CONNECTION_UPDATE, CHATS_UPSERT, CHATS_UPDATE, CHATS_DELETE,
#            CONTACTS_UPSERT, CONTACTS_UPDATE, GROUPS_UPSERT, GROUPS_UPDATE,
#            GROUP_PARTICIPANTS_UPDATE, PRESENCE_UPDATE, LABELS_EDIT, LABELS_ASSOCIATION,
#            BLOCKLIST_SET, BLOCKLIST_UPDATE, QRCODE_UPDATED, etc.
WEBHOOK_ALLOWED_EVENTS=ALL
# Retry policy for webhook delivery
WEBHOOK_RETRY_MAX=3
WEBHOOK_RETRY_INTERVAL=5000
WEBHOOK_BACKOFF_FACTOR=3
# Smart retry by HTTP status (default on):
# - 4xx (except 408/425/429): not retried — retrying a bad request never helps.
# - 429 / 503: when the response carries a Retry-After header it is honored
#   (capped at 5 min) instead of the fixed backoff.
# - 5xx / 408 / 425: retried with exponential backoff as before.
# Set WEBHOOK_RETRY_HTTP_429=false to ignore Retry-After and always use backoff.
WEBHOOK_RETRY_HTTP_429=true
# Optional override of the retryable status set (comma-separated).
# Default: 408,425,429,500,502,503,504
# WEBHOOK_RETRYABLE_STATUSES=408,425,429,500,502,503,504
# Signature mode for outbound webhooks:
# - off      : no signature headers
# - optional : include signature headers when a secret is available
# - required : fail send when no secret is available (recommended once the
#              receiver verifies X-Webhook-Signature)
WEBHOOK_SIGNATURE_MODE=optional
# Legacy static token headers (x-webhook-secret + Authorization: Bearer).
# Keep true while receivers still authenticate with the token. Set false after
# they verify the HMAC signature: the secret then never travels on the wire.
WEBHOOK_INCLUDE_TOKEN=true
# After a manual rotation, keep the previous secret as the PRIMARY signature
# and token for this many milliseconds, so existing receivers keep working
# while they are updated. The new secret is also sent in the -new headers.
# 0 = invalidate the old secret immediately (use after a leak).
WEBHOOK_SECRET_GRACE_MS=86400000
# Max concurrent outbound webhook requests globally
WEBHOOK_CONCURRENCY=20
# Outbound rate limit per receiver URL (token bucket). 0 = disabled (legacy).
# When > 0, at most N webhook requests per minute are sent to the SAME endpoint;
# extra events wait (bounded by WEBHOOK_RATE_MAX_WAIT_MS) instead of being dropped.
# Prevents flooding a third-party receiver and getting our IP rate-limited/banned.
WEBHOOK_RATE_PER_MIN=0
# Max ms an event waits for a free per-URL slot before proceeding anyway (fail-open).
WEBHOOK_RATE_MAX_WAIT_MS=30000
# Dead-letter buffer for webhooks that exhausted all retries (default off = dropped).
# When enabled, permanently-failed deliveries are kept in memory (and persisted
# to WEBHOOK_DEAD_LETTER_DIR as JSONL when set) so operators can replay them via
# the dashboard (GET /dashboard/api/webhooks/dead-letter,
# POST .../dead-letter/:id/retry, POST .../dead-letter/retry-all).
WEBHOOK_DEAD_LETTER_ENABLED=false
WEBHOOK_DEAD_LETTER_DIR=
# Per-URL circuit breaker: after N consecutive genuine receiver failures
# (retryable 5xx / network errors — NOT 4xx client errors or healthy 429s),
# delivery to that endpoint pauses for resetMs instead of hammering a dead
# server. Skipped events are logged (status "skipped") and are NOT dead-lettered.
# 0 disables the breaker.
WEBHOOK_CIRCUIT_FAILURES=5
WEBHOOK_CIRCUIT_RESET_MS=30000
# Compress webhook payloads with gzip when the JSON body exceeds this many
# bytes (media-carrying events can be large). 0 = never compress.
# Receivers must handle Content-Encoding: gzip (most HTTP clients do); the
# webhook signature is computed over the uncompressed JSON so it stays
# verifiable after decompression.
WEBHOOK_GZIP_THRESHOLD=16384
# SSRF guard: block webhook URLs pointing at internal/private targets
# (localhost, 127.x, 10.x, 172.16-31.x, 192.168.x, 169.254.169.254, *.local, *.internal).
# Default false = allowed, so local testing against localhost receivers works.
# Enable in production when webhook URLs may be set by untrusted users.
# When enabled, DNS answers are checked too and redirects are never followed.
WEBHOOK_BLOCK_INTERNAL=false

# ===================================
# Broadcast / Bulk Message Configuration
# ===================================
# Minimum delay between individual messages (ms)
BROADCAST_MIN_DELAY_MS=1500
# Maximum delay between individual messages (ms)
BROADCAST_MAX_DELAY_MS=3000
# Number of messages to send before a batch pause
BROADCAST_BATCH_SIZE=10
# Pause duration between batches (ms)
BROADCAST_BATCH_PAUSE_MS=5000
# Show a "composing…" typing bubble per recipient during broadcasts.
# Default: false — safer & less bot-like (typing bubbles to strangers are odd).
# NOTE: when true, each recipient ALSO incurs the typing delay from
# SIMULATE_TYPING_DELAY_* on top of BROADCAST_MIN/MAX_DELAY_MS.
BROADCAST_TYPING_SIMULATION=false
# Delay distribution between broadcast messages:
# - uniform : constant random between MIN/MAX (legacy)
# - human   : mix of short gaps, occasional longer pauses + jitter (WA-like)
BROADCAST_DELAY_DISTRIBUTION=uniform
# Check recipient WA-registration in batches instead of 1-by-1.
# Fewer usync queries to WA servers = smaller footprint & faster jobs.
# true  → batch via CHECK_WA_BATCH_SIZE
# false → 1-by-1 (legacy)
BROADCAST_BATCH_CHECK_WA=false
# Batch size for BROADCAST_BATCH_CHECK_WA=true
BROADCAST_CHECK_WA_BATCH_SIZE=50

# ===================================
# Media Configuration
# ===================================
# Include media as base64 in webhook payloads
MEDIA_INCLUDE_BASE64=false
# Enable automatic cleanup of old media files
MEDIA_CLEANUP_ENABLED=true
# Cleanup interval (ms) - default 1 hour
MEDIA_CLEANUP_INTERVAL_MS=3600000
# Max age of media files (hours)
MEDIA_MAX_AGE_HOURS=24
# Reject media URLs that resolve to private/internal hosts (SSRF guard).
MEDIA_BLOCK_INTERNAL=true

# ===================================
# CORS Configuration
# ===================================
# Allowed origins for cross-origin requests.
# Use '*' to allow all origins (default, acceptable for API-only servers).
# For multiple domains, use comma-separated values:
# CORS_ORIGIN=https://app1.example.com,https://app2.example.com,https://admin.example.com
# Note: CORS only affects browser requests. Webhooks and server-to-server
# calls are NOT affected by CORS settings.
# With "*", only SAME-ORIGIN requests are reflected (cross-site browser reads
# are blocked). Set an explicit comma-separated list when browser clients live
# on another origin.
CORS_ORIGIN=*

# ===================================
# Proxy / Network Configuration
# ===================================
# Trust proxy headers (x-forwarded-for / x-real-ip / cf-connecting-ip) for
# client IP detection (rate limiting / auth).
# - false (default): use socket remote address. Safe when exposed directly.
# - true: trust proxy headers. Enable ONLY behind a trusted reverse proxy /
#   load balancer (e.g. Nginx, Caddy, Cloudflare, AWS ALB). If enabled while
#   directly exposed, clients can spoof these headers to bypass rate limits.
#   It also drives HTTPS detection (x-forwarded-proto): the dashboard cookie
#   gets Secure, HSTS is sent, and plain-HTTP dashboard requests redirect.
TRUST_PROXY=false

# ===================================
# Dashboard Configuration
# ===================================
# Enable/disable the web dashboard (default: true)
DASHBOARD_ENABLED=true
# Allow new user registration (default: false)
# First user can always register (admin setup)
DASHBOARD_REGISTRATION_ENABLED=false
# Require admin approval for newly registered users before first login.
# false = users become active immediately after registration.
# true  = users are created with pending status until approved by an admin.
DASHBOARD_REGISTRATION_REQUIRE_APPROVAL=true
# JWT secret for dashboard sessions.
# ⚠️ REQUIRED in production: if unset or still the default, dashboard auth is
#   DISABLED (fail-closed, returns 503) rather than signing tokens with a
#   publicly-known default secret. Generate: openssl rand -base64 48
DASHBOARD_JWT_SECRET=change-this-to-a-random-secret
# Single minimum password length for all environments.
# Keep it simple and consistent (recommended >= 6).
DASHBOARD_PASSWORD_MIN_LENGTH=6

# ===================================
# WA Web Behavior Simulation
# ===================================
# Auto-send "composing" presence before each message (default: true)
SIMULATE_TYPING_BEFORE_SEND=true
# Typing delay range in ms (random between min-max)
SIMULATE_TYPING_DELAY_MIN_MS=1500
SIMULATE_TYPING_DELAY_MAX_MS=3000
# ---------------------------------------------------------------------------
# AUTO_READ_MESSAGES — RISK WARNING
# ---------------------------------------------------------------------------
# When enabled, EVERY incoming message is marked read automatically.
# A real human does NOT open & read 100% of chats instantly, 24/7.
# Instant 0ms read receipts on every message is a well-known bot signature
# and can contribute to account bans. Leave OFF unless you truly need it.
# If you DO enable it, also set AUTO_READ_DELAY_ENABLED=true below so reads
# happen after a natural "opened chat" delay instead of instantly.
# (default: false, like the WA Web "read receipts" toggle)
AUTO_READ_MESSAGES=false
# Simulate a natural "opened chat" delay before marking messages as read
# (only applies when AUTO_READ_MESSAGES=true). Without this, reads fire
# instantly at 0ms — bot-like. Recommended: keep enabled.
# true  → random delay in [AUTO_READ_DELAY_MIN_MS, AUTO_READ_DELAY_MAX_MS]
# false → read instantly (legacy behavior)
AUTO_READ_DELAY_ENABLED=true
# Random "opened chat" delay range (ms) before a read receipt is sent.
# Human-like range, NOT milliseconds-instant.
AUTO_READ_DELAY_MIN_MS=1500
AUTO_READ_DELAY_MAX_MS=4000
# Auto-set presence to "available" when sending messages (default: true)
AUTO_MARK_ONLINE=true
# Auto-reject incoming calls
REJECT_CALLS=false
# Automatically reject incoming calls to prevent numbers from getting banned (default: false)
REJECT_CALLS=false

# ===================================
# Humanized Interaction (WA-Web-like pacing)
# ===================================
# All knobs below default to the LEGACY behavior (everything instant/off)
# so existing deployments are unaffected until you opt in.
#
# Mark an incoming message as read before auto-replying to it (1-on-1 chats
# only). Reproduces "open chat → read → type" instead of replying with no
# prior read receipt (bot-like). Requires a natural read delay:
#   true  → wait HUMANIZE_READ_* range, mark read, then compose & send
#   false → send reply without an explicit read step (legacy)
HUMANIZE_READ_BEFORE_REPLY=true
# Random "reading" delay range (ms) before the read receipt is sent.
# Scales with incoming message length when enabled.
HUMANIZE_READ_DELAY_MIN_MS=800
HUMANIZE_READ_DELAY_MAX_MS=2500
# Random "thinking" gap (ms) before typing starts (after read).
# 0/0 → no thinking gap (legacy)
HUMANIZE_THINK_MIN_MS=800
HUMANIZE_THINK_MAX_MS=2000
# Typing ("composing") duration becomes proportional to reply length when
# enabled, instead of a fixed random range. (ms bounds still apply)
# Default false = legacy fixed random typing delay (SIMULATE_TYPING_DELAY_*)
HUMANIZE_TYPING_PROPORTIONAL=false
# Min gap between repeated composing/paused to the SAME chat (ms).
# 0 → send presence every time (legacy). Helps avoid rapid toggling.
HUMANIZE_PRESENCE_DEDUPE_MS=0
# Global pacing: min/max random gap between ANY outbound actions within a
# session (across chats). Prevents bursts when many messages/requests arrive
# at once. 0/0 → no global pacing (legacy)
HUMANIZE_GLOBAL_PACING_MIN_MS=0
HUMANIZE_GLOBAL_PACING_MAX_MS=0
# Delay pattern for humanize read/think gaps.
# uniform = random min-max (legacy).
# human   = short gaps most of the time with occasional longer pauses
#           (same distribution as BROADCAST_DELAY_DISTRIBUTION=human).
HUMANIZE_DELAY_DISTRIBUTION=uniform

# ===================================
# AI Auto-Response (per-number, overridable from dashboard)
# ===================================
# These are GLOBAL DEFAULTS only. Each WhatsApp number stores its own overrides
# (window, model, system instruction, RAG endpoints, credentials) in the session
# metadata, editable from the dashboard:
#   GET   /dashboard/api/sessions/:id/ai-config
#   PATCH /dashboard/api/sessions/:id/ai-config
#
# Routing rule: inside the AI window the AI answers, UNLESS a human replied in
# that conversation within ROUTING_HUMAN_IDLE_MS. A human reply from the phone,
# WhatsApp Web or the dashboard counts; messages sent by this API do not.

# What the AI driver talks to:
#   openai  = any OpenAI-compatible API (OpenRouter, OpenAI, Groq, Ollama, ...)
#   webhook = an external agent gateway (e.g. your own apiLLM service)
AI_DRIVER=openai
# When the AI may answer. Per-number override: ai.mode
#   off    = never; the static AUTO_REPLY_* rules handle messages instead
#   window = only inside AI_WINDOW_START..AI_WINDOW_END (default)
#   always = full handling 24/7 (still pauseable by a human reply/handoff)
AI_MODE=window
# OpenAI-compatible base URL. Per-number override: ai.baseUrl
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI:     https://api.openai.com/v1
# Ollama:     http://localhost:11434/v1   (needs AI_TOOL_BLOCK_INTERNAL=false)
AI_BASE_URL=https://openrouter.ai/api/v1
# Default model slug. Per-number override: ai.model
# Examples: openai/gpt-4o-mini | anthropic/claude-3.5-sonnet | gpt-4o-mini
AI_MODEL=
# Sampling temperature (0-2).
AI_TEMPERATURE=0.6
# Nucleus sampling (0-1).
AI_TOP_P=0.95
# Min-p sampling. Only sent when the base URL is OpenRouter (other providers
# reject unknown parameters); 0 disables it.
AI_MIN_P=0.05
# Frequency / presence penalties (-2..2). Standard default 0.
AI_FREQUENCY_PENALTY=0
AI_PRESENCE_PENALTY=0
# Max tokens of the generated reply (1024 keeps replies well under a WA message).
AI_MAX_TOKENS=1024
# Timeout for one provider call (ms). 429/5xx are retried automatically.
AI_TIMEOUT_MS=25000
# Max tool-calling rounds per reply (0 = never call tools).
AI_TOOL_MAX_ROUNDS=2
# Timeout for one knowledge-endpoint call (ms).
AI_TOOL_TIMEOUT_MS=8000
# Max characters kept from each endpoint response (context-bloat guard).
AI_TOOL_MAX_RESPONSE_CHARS=2000
# Refuse configured tool URLs that point at private/loopback hosts.
# false = allowed (local testing) | true = recommended in production.
AI_TOOL_BLOCK_INTERNAL=false
# Prompt-injection tripwire + abuse control. Heuristics are a signal, not a
# boundary: the real limits are allowlisted tools, no secrets in the prompt,
# output scrubbing (credential-shaped text is redacted) and this mute policy.
# Prompt history: count cap, age window (default 6 hours) and character budget.
AI_HISTORY_MAX_MESSAGES=12
AI_HISTORY_MAX_AGE_MS=21600000
AI_HISTORY_MAX_CHARS=8000
# Unified /messages endpoint: group sending is disabled by default.
# Enable deliberately and, if you can, restrict it to known groups.
ALLOW_GROUP_SEND=false
# Comma-separated group JIDs or numeric ids (empty = every group when enabled).
ALLOWED_GROUP_JIDS=
# Inbound API audit log (Dashboard -> REST API -> Request log)
AUDIT_LOG_ENABLED=true
# Store the request body in the audit log (off by default: privacy)
AUDIT_LOG_BODY=false
AUDIT_LOG_RETENTION_DAYS=7
AUDIT_LOG_MAX_ENTRIES=5000
AI_GUARD_ENABLED=true
# Score (0-100+) at or above which a message is refused outright.
AI_GUARD_BLOCK_SCORE=50
# Blocked attempts before the conversation is muted.
AI_GUARD_MAX_STRIKES=3
# Mute duration. Messages received during a mute are ignored (nothing queued),
# so no stale backlog is answered afterwards; a new message resumes normally.
AI_GUARD_MUTE_MS=900000
# Hard cap on inbound text handed to the model (prevents context flooding).
AI_GUARD_MAX_INPUT_CHARS=4000
# Only used when AI_DRIVER=webhook (external gateway).
AI_AGENT_URL=
# Service identity for gateway -> API internal calls (not a per-user secret).
AI_SERVICE_TOKEN=

# --- Time window (global defaults, per-number override in dashboard) ---
# IANA timezone used to evaluate the window (never the server clock).
ROUTING_TZ=Asia/Jakarta
# Window where the AI answers. Cross-midnight supported; same value = all day.
AI_WINDOW_START=16:00
AI_WINDOW_END=08:00
# Debounce before forwarding a batch; resets on every new inbound message.
ROUTING_BATCH_IDLE_MS=20000
# Hard cap so a continuously typing customer cannot delay forever.
ROUTING_BATCH_MAX_WAIT_MS=60000
# Max messages folded into one AI prompt.
ROUTING_MAX_BATCH_MESSAGES=8
# How long a conversation stays human-owned after human activity (15 min).
ROUTING_HUMAN_IDLE_MS=900000
# Pause applied when the AI asks for a human takeover (30 min).
ROUTING_HANDOFF_PAUSE_MS=1800000

# --- Secrets at rest ---
# Passphrase used to encrypt per-number credentials (provider key, endpoint
# headers and the webhook secret) before they are written to session metadata.
# Any length; the key is derived with SHA-256. Without it, secrets are stored
# with a "plain:" prefix (backward compatible, not encrypted).
CONFIG_ENC_KEY=

# ===================================
# Optional YouTube downloader via WhatsApp (private chats only)
# ===================================
# Set true to enable downloads. When disabled, !yt receives a setup explanation.
YOUTUBE_WA_ENABLED=false
# Authorized command-sender numbers (not necessarily the paired bot number),
# country code included, digits only, comma-separated. For self-chat, include
# the paired WhatsApp number. Never use a public/shared allowlist.
# Example: 15551234567,447700900123
YOUTUBE_WA_ALLOWED_SENDERS=
# Resource guards for each request.
YOUTUBE_WA_MAX_SIZE_MB=100
YOUTUBE_WA_MAX_DURATION_SECONDS=1800
# Optional tool overrides for non-standard installs:
# YTDLP_PATH=/usr/local/bin/yt-dlp
# TOOLS_DIR=/usr/local/bin
